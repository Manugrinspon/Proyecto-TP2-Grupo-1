# Puerto donde escucha el servidor HTTP
PORT=8000

# Entorno de ejecución: development | production
NODE_ENV=development

# Motor de persistencia: memory | sequelize
PERSISTENCE_TYPE=memory

# Canal de salida para las notificaciones: console | file
NOTIFIER_TYPE=console

# Ruta del archivo de log cuando NOTIFIER_TYPE=file
NOTIFICATIONS_LOG_PATH=notifications.log

# Umbral de cupo disponible para disparar la alerta de cupo bajo
CUPO_BAJO_UMBRAL=2